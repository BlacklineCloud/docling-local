# Docker Compose project
COMPOSE_PROJECT_NAME=docling-local

# Pin the upstream image for reproducible deployments.
DOCLING_IMAGE_REPOSITORY=quay.io/docling-project/docling-serve
DOCLING_VERSION=v1.23.0

# Network exposure. Keep 127.0.0.1 unless a trusted reverse proxy or private
# network provides access control.
DOCLING_BIND_ADDRESS=127.0.0.1
DOCLING_PORT=5001

# The bundled Gradio UI is convenient for internal use but is not durable
# document storage.
DOCLING_SERVE_ENABLE_UI=1

# Strongly recommended before exposing the service beyond localhost.
# Generate one with: openssl rand -hex 32
DOCLING_API_KEY=

# Single-host local engine settings.
DOCLING_LOCAL_WORKERS=2
DOCLING_SHARE_MODELS=true
UVICORN_WORKERS=1

# Docling runtime settings. Use auto for normal CPU deployments. GPU users
# must also select a compatible upstream image and configure the container
# runtime.
DOCLING_DEVICE=auto
DOCLING_NUM_THREADS=4

# Hugging Face download compatibility.
HF_HUB_DISABLE_XET=1

# Persistent cache and bounded Docker logs.
DOCLING_CACHE_VOLUME=docling-local-cache
DOCLING_LOG_MAX_SIZE=10m
DOCLING_LOG_MAX_FILES=3

# Used by the included local client and smoke-test script.
DOCLING_API_URL=http://127.0.0.1:5001
